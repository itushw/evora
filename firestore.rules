rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isGoogleSso() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isAdmin() {
      return isGoogleSso() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || (
          request.auth.token.email == 'brownsquad67@gmail.com'
          && request.auth.token.email_verified == true
        )
      );
    }

    function isAutoApproveEnabled() {
      return exists(/databases/$(database)/documents/settings/platform)
        && get(/databases/$(database)/documents/settings/platform).data.autoApproveEvents == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isNonEmptyString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isBoundedString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidOptionalNumber(data, field, minVal, maxVal) {
      return !(field in data) || (data[field] is number && data[field] >= minVal && data[field] <= maxVal);
    }

    function isValidCategory(cat) {
      return cat in ['Tech', 'Music', 'Arts', 'College Fests', 'Workshops'];
    }

    function isValidCoverImage(val) {
      return val is string
        && val.size() >= 8
        && val.size() <= 260000
        && (
          (val.size() >= 12 && val[0:12] == '/src/assets/')
          || (val.size() >= 8 && val[0:8] == '/assets/')
          || val[0:8] == 'https://'
          || (val.size() >= 24 && (
            val[0:23] == 'data:image/jpeg;base64,'
            || val[0:22] == 'data:image/png;base64,'
            || val[0:23] == 'data:image/webp;base64,'
          ))
        );
    }

    function isValidHost(host) {
      return host is map
        && host.keys().hasAll(['name', 'organization', 'role', 'contactEmail'])
        && host.keys().hasOnly(['name', 'organization', 'role', 'contactEmail'])
        && isNonEmptyString(host.name, 1, 100)
        && isNonEmptyString(host.organization, 1, 120)
        && isNonEmptyString(host.role, 1, 80)
        && isNonEmptyString(host.contactEmail, 3, 160);
    }

    function isValidUserCreate(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'provider', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'provider', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && isNonEmptyString(data.displayName, 1, 100)
        && isNonEmptyString(data.email, 3, 160)
        && data.provider in ['password', 'google']
        && isNonEmptyString(data.createdAt, 10, 40)
        && isNonEmptyString(data.updatedAt, 10, 40);
    }

    function isValidUserUpdate(newData, oldData) {
      return newData.diff(oldData).affectedKeys().hasOnly(['displayName', 'provider', 'updatedAt'])
        && newData.uid == oldData.uid
        && newData.email == oldData.email
        && newData.createdAt == oldData.createdAt
        && isNonEmptyString(newData.displayName, 1, 100)
        && newData.provider in ['password', 'google']
        && isNonEmptyString(newData.updatedAt, 10, 40);
    }

    function isValidAdminRecord(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedAt'])
        && data.uid == adminId
        && isNonEmptyString(data.email, 3, 160)
        && isNonEmptyString(data.grantedAt, 10, 40);
    }

    function isValidPlatformSettings(data) {
      return data.keys().hasAll([
          'heroHeadline', 'heroSubheadline', 'ctaHeadline', 'ctaSubheadline',
          'announcementEnabled', 'announcementText', 'announcementLinkLabel',
          'announcementLinkUrl', 'showPricingPage', 'showSeedEvents',
          'autoApproveEvents', 'allowEventSubmissions', 'allowBookings',
          'bookingsPausedMessage', 'platformFeePercent', 'defaultPayoutVpa',
          'defaultPayeeName', 'supportEmail', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'heroHeadline', 'heroSubheadline', 'ctaHeadline', 'ctaSubheadline',
          'announcementEnabled', 'announcementText', 'announcementLinkLabel',
          'announcementLinkUrl', 'showPricingPage', 'showSeedEvents',
          'autoApproveEvents', 'allowEventSubmissions', 'allowBookings',
          'bookingsPausedMessage', 'platformFeePercent', 'defaultPayoutVpa',
          'defaultPayeeName', 'supportEmail', 'updatedAt', 'updatedBy'
        ])
        && isNonEmptyString(data.heroHeadline, 1, 180)
        && isBoundedString(data.heroSubheadline, 400)
        && isBoundedString(data.ctaHeadline, 180)
        && isBoundedString(data.ctaSubheadline, 400)
        && data.announcementEnabled is bool
        && isBoundedString(data.announcementText, 240)
        && isBoundedString(data.announcementLinkLabel, 60)
        && isBoundedString(data.announcementLinkUrl, 240)
        && data.showPricingPage is bool
        && data.showSeedEvents is bool
        && data.autoApproveEvents is bool
        && data.allowEventSubmissions is bool
        && data.allowBookings is bool
        && isBoundedString(data.bookingsPausedMessage, 260)
        && data.platformFeePercent is number
        && data.platformFeePercent >= 0
        && data.platformFeePercent <= 20
        && isBoundedString(data.defaultPayoutVpa, 100)
        && isBoundedString(data.defaultPayeeName, 80)
        && isBoundedString(data.supportEmail, 160)
        && isNonEmptyString(data.updatedAt, 10, 40)
        && isNonEmptyString(data.updatedBy, 1, 160);
    }

    function isValidEventDoc(data, eventId) {
      return data.keys().hasAll([
          'id', 'slug', 'title', 'subtitle', 'category', 'city',
          'venueName', 'venueAddress', 'dateLabel', 'isoDate',
          'timeLabel', 'timezone', 'coverImage', 'coverCaption',
          'description', 'host', 'schedule', 'tiers',
          'refundPolicySummary', 'creatorUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'slug', 'title', 'subtitle', 'category', 'city',
          'venueName', 'venueAddress', 'dateLabel', 'isoDate',
          'timeLabel', 'timezone', 'coverImage', 'coverCaption',
          'description', 'host', 'schedule', 'tiers',
          'refundPolicySummary', 'creatorUid', 'createdAt', 'updatedAt',
          'placeId', 'latitude', 'longitude', 'featured',
          'payoutVpa', 'approvalStatus', 'reviewNote', 'reviewedAt', 'reviewedBy'
        ])
        && data.id == eventId
        && isNonEmptyString(data.slug, 2, 120)
        && isNonEmptyString(data.title, 2, 160)
        && isNonEmptyString(data.subtitle, 2, 320)
        && isValidCategory(data.category)
        && isNonEmptyString(data.city, 2, 80)
        && isNonEmptyString(data.venueName, 2, 160)
        && isNonEmptyString(data.venueAddress, 2, 300)
        && isNonEmptyString(data.dateLabel, 2, 60)
        && isNonEmptyString(data.isoDate, 8, 20)
        && isNonEmptyString(data.timeLabel, 2, 60)
        && isNonEmptyString(data.timezone, 2, 20)
        && isValidCoverImage(data.coverImage)
        && isNonEmptyString(data.coverCaption, 2, 220)
        && data.description is list && data.description.size() >= 1 && data.description.size() <= 12
        && isValidHost(data.host)
        && data.schedule is list && data.schedule.size() >= 1 && data.schedule.size() <= 20
        && data.tiers is list && data.tiers.size() >= 1 && data.tiers.size() <= 10
        && isNonEmptyString(data.refundPolicySummary, 2, 300)
        && isNonEmptyString(data.creatorUid, 3, 128)
        && isNonEmptyString(data.createdAt, 10, 40)
        && isNonEmptyString(data.updatedAt, 10, 40)
        && isValidOptionalString(data, 'placeId', 200)
        && isValidOptionalNumber(data, 'latitude', -90, 90)
        && isValidOptionalNumber(data, 'longitude', -180, 180)
        && (!('featured' in data) || data.featured is bool)
        && isValidOptionalString(data, 'payoutVpa', 100)
        && (!('approvalStatus' in data) || data.approvalStatus in ['pending', 'approved', 'rejected'])
        && isValidOptionalString(data, 'reviewNote', 300)
        && isValidOptionalString(data, 'reviewedAt', 40)
        && isValidOptionalString(data, 'reviewedBy', 160);
    }

    function isValidOrderCreate(data, orderId) {
      return data.keys().hasAll([
          'orderId', 'intentId', 'userId', 'status', 'createdAt',
          'eventId', 'eventSlug', 'eventTitle', 'eventDateLabel',
          'eventTimeLabel', 'venueName', 'venueAddress', 'city',
          'tierId', 'tierName', 'quantity', 'buyerName', 'buyerEmail',
          'buyerPhone', 'paymentReference', 'currency',
          'subtotalPaise', 'platformFeePaise', 'totalPaise', 'passes'
        ])
        && data.keys().hasOnly([
          'orderId', 'intentId', 'userId', 'status', 'createdAt',
          'eventId', 'eventSlug', 'eventTitle', 'eventDateLabel',
          'eventTimeLabel', 'venueName', 'venueAddress', 'city',
          'tierId', 'tierName', 'quantity', 'buyerName', 'buyerEmail',
          'buyerPhone', 'paymentReference', 'currency',
          'subtotalPaise', 'platformFeePaise', 'totalPaise', 'passes'
        ])
        && data.orderId == orderId
        && isNonEmptyString(data.intentId, 4, 60)
        && data.userId == request.auth.uid
        && data.status == 'confirmed'
        && isNonEmptyString(data.createdAt, 10, 40)
        && isNonEmptyString(data.eventId, 3, 128)
        && isNonEmptyString(data.eventSlug, 2, 120)
        && isNonEmptyString(data.eventTitle, 2, 160)
        && isNonEmptyString(data.eventDateLabel, 2, 60)
        && isNonEmptyString(data.eventTimeLabel, 2, 60)
        && isNonEmptyString(data.venueName, 2, 160)
        && isNonEmptyString(data.venueAddress, 2, 300)
        && isNonEmptyString(data.city, 2, 80)
        && isNonEmptyString(data.tierId, 2, 120)
        && isNonEmptyString(data.tierName, 1, 100)
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 10
        && isNonEmptyString(data.buyerName, 1, 100)
        && isNonEmptyString(data.buyerEmail, 3, 160)
        && data.buyerPhone is string && data.buyerPhone.size() <= 30
        && isNonEmptyString(data.paymentReference, 2, 60)
        && data.currency == 'INR'
        && data.subtotalPaise is int && data.subtotalPaise >= 0 && data.subtotalPaise <= 100000000
        && data.platformFeePaise is int && data.platformFeePaise >= 0 && data.platformFeePaise <= 10000000
        && data.totalPaise is int && data.totalPaise == data.subtotalPaise + data.platformFeePaise
        && data.passes is list && data.passes.size() == data.quantity;
    }

    function isValidOrderAdminUpdate(newData, oldData) {
      return newData.diff(oldData).affectedKeys().hasOnly(['status', 'refundedAt', 'passes'])
        && newData.orderId == oldData.orderId
        && newData.intentId == oldData.intentId
        && newData.userId == oldData.userId
        && newData.createdAt == oldData.createdAt
        && newData.eventId == oldData.eventId
        && newData.currency == oldData.currency
        && newData.status in ['confirmed', 'refunded']
        && newData.passes is list
        && newData.passes.size() == oldData.passes.size()
        && isValidOptionalString(newData, 'refundedAt', 40);
    }

    match /settings/{settingId} {
      allow get: if settingId == 'platform';
      allow list: if false;
      allow create, update: if isAdmin()
        && settingId == 'platform'
        && isValidPlatformSettings(request.resource.data);
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserCreate(request.resource.data, userId);
      allow update: if (isOwner(userId) || isAdmin())
        && isValidUserUpdate(request.resource.data, resource.data);
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(adminId)
        && isValidAdminRecord(request.resource.data, adminId);
      allow delete: if isAdmin() && isValidId(adminId);
    }

    match /events/{eventId} {
      allow get, list: if true;
      allow create: if isSignedIn()
        && isValidId(eventId)
        && isValidEventDoc(request.resource.data, eventId)
        && (
          isAdmin()
          || (
            request.resource.data.creatorUid == request.auth.uid
            && (
              request.resource.data.approvalStatus == 'pending'
              || (request.resource.data.approvalStatus == 'approved' && isAutoApproveEnabled())
            )
          )
        );
      allow update: if isSignedIn()
        && isValidEventDoc(request.resource.data, eventId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          isAdmin()
          || (
            resource.data.creatorUid == request.auth.uid
            && request.resource.data.slug == resource.data.slug
            && request.resource.data.creatorUid == resource.data.creatorUid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approvalStatus', 'reviewNote', 'reviewedAt', 'reviewedBy'])
          )
          || (
            request.resource.data.slug == resource.data.slug
            && request.resource.data.creatorUid == resource.data.creatorUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tiers', 'updatedAt'])
            && request.resource.data.tiers.size() == resource.data.tiers.size()
          )
        );
      allow delete: if isSignedIn()
        && (resource.data.creatorUid == request.auth.uid || isAdmin());
    }

    match /orders/{orderId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(orderId)
        && isValidOrderCreate(request.resource.data, orderId);
      allow update: if isSignedIn()
        && (
          (
            resource.data.userId == request.auth.uid
            && resource.data.status == 'confirmed'
            && request.resource.data.status == 'refunded'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'refundedAt'])
            && isNonEmptyString(request.resource.data.refundedAt, 10, 40)
          )
          || (
            isAdmin()
            && isValidOrderAdminUpdate(request.resource.data, resource.data)
          )
        );
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
