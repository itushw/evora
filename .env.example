# GEMINI_API_KEY: Optional AI Studio secret placeholder.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of Evora.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for Maps JavaScript, Places, and Geocoding.
VITE_GOOGLE_MAPS_API_KEY=""

# EVORA_SETTLEMENT_VPA: Merchant settlement address encoded into checkout QR codes.
EVORA_SETTLEMENT_VPA=""

# PAYMENT_SIGNING_SECRET: Secret used to sign issued ticket QR passes.
PAYMENT_SIGNING_SECRET="evora-dev-signing-secret"
