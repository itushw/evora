{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated attendee or organizer profile linked to Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID matching document ID." },
        "displayName": { "type": "string", "description": "User full name." },
        "email": { "type": "string", "format": "email", "description": "Account email address." },
        "provider": { "type": "string", "enum": ["password", "google"], "description": "Primary sign-in provider." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "provider", "createdAt", "updatedAt"]
    },
    "EvoraEvent": {
      "title": "EvoraEvent",
      "description": "Public campus or city event listing published on Evora.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["Tech", "Music", "Arts", "College Fests", "Workshops"]
        },
        "city": { "type": "string" },
        "venueName": { "type": "string" },
        "venueAddress": { "type": "string" },
        "placeId": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "dateLabel": { "type": "string" },
        "isoDate": { "type": "string" },
        "timeLabel": { "type": "string" },
        "timezone": { "type": "string" },
        "coverImage": { "type": "string" },
        "coverCaption": { "type": "string" },
        "description": { "type": "array", "items": { "type": "string" } },
        "host": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "organization": { "type": "string" },
            "role": { "type": "string" },
            "contactEmail": { "type": "string" }
          }
        },
        "schedule": { "type": "array" },
        "tiers": { "type": "array" },
        "refundPolicySummary": { "type": "string" },
        "featured": { "type": "boolean" },
        "creatorUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "slug",
        "title",
        "subtitle",
        "category",
        "city",
        "venueName",
        "venueAddress",
        "dateLabel",
        "isoDate",
        "timeLabel",
        "timezone",
        "coverImage",
        "coverCaption",
        "description",
        "host",
        "schedule",
        "tiers",
        "refundPolicySummary",
        "creatorUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "TicketOrder": {
      "title": "TicketOrder",
      "description": "Confirmed or cancelled attendee ticket booking owned by a Firebase Auth user.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "intentId": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["confirmed", "refunded"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "refundedAt": { "type": "string", "format": "date-time" },
        "eventId": { "type": "string" },
        "eventSlug": { "type": "string" },
        "eventTitle": { "type": "string" },
        "eventDateLabel": { "type": "string" },
        "eventTimeLabel": { "type": "string" },
        "venueName": { "type": "string" },
        "venueAddress": { "type": "string" },
        "city": { "type": "string" },
        "tierId": { "type": "string" },
        "tierName": { "type": "string" },
        "quantity": { "type": "integer" },
        "buyerName": { "type": "string" },
        "buyerEmail": { "type": "string" },
        "buyerPhone": { "type": "string" },
        "paymentReference": { "type": "string" },
        "currency": { "type": "string", "enum": ["INR"] },
        "subtotalPaise": { "type": "integer" },
        "platformFeePaise": { "type": "integer" },
        "totalPaise": { "type": "integer" },
        "passes": { "type": "array" }
      },
      "required": [
        "orderId",
        "intentId",
        "userId",
        "status",
        "createdAt",
        "eventId",
        "eventSlug",
        "eventTitle",
        "eventDateLabel",
        "eventTimeLabel",
        "venueName",
        "venueAddress",
        "city",
        "tierId",
        "tierName",
        "quantity",
        "buyerName",
        "buyerEmail",
        "buyerPhone",
        "paymentReference",
        "currency",
        "subtotalPaise",
        "platformFeePaise",
        "totalPaise",
        "passes"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profiles readable and writable only by the owning user."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/EvoraEvent" },
      "description": "Publicly readable event listings created by authenticated organizers."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/TicketOrder" },
      "description": "Private attendee ticket orders and issued passes readable only by the owning user."
    }
  }
}
