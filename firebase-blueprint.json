{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated attendee or organizer profile linked to Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID matching document ID." },
        "displayName": { "type": "string", "description": "User full name." },
        "email": { "type": "string", "format": "email", "description": "Account email address." },
        "provider": { "type": "string", "enum": ["password", "google"], "description": "Primary sign-in provider." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "provider", "createdAt", "updatedAt"]
    },
    "EvoraEvent": {
      "title": "EvoraEvent",
      "description": "Public campus or city event listing published on Evora.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["Tech", "Music", "Arts", "College Fests", "Workshops"]
        },
        "city": { "type": "string" },
        "venueName": { "type": "string" },
        "venueAddress": { "type": "string" },
        "placeId": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "dateLabel": { "type": "string" },
        "isoDate": { "type": "string" },
        "timeLabel": { "type": "string" },
        "timezone": { "type": "string" },
        "coverImage": {
          "type": "string",
          "maxLength": 260000,
          "description": "Relative asset path, HTTPS URL, or compressed JPEG/PNG/WebP data URL."
        },
        "coverCaption": { "type": "string" },
        "description": { "type": "array", "items": { "type": "string" } },
        "host": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "organization": { "type": "string" },
            "role": { "type": "string" },
            "contactEmail": { "type": "string" }
          }
        },
        "schedule": { "type": "array" },
        "tiers": { "type": "array" },
        "refundPolicySummary": { "type": "string" },
        "payoutVpa": { "type": "string", "maxLength": 100, "description": "Optional organizer UPI VPA for direct attendee payments." },
        "approvalStatus": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Admin moderation status controlling public visibility." },
        "reviewNote": { "type": "string", "maxLength": 300 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewedBy": { "type": "string", "maxLength": 160 },
        "featured": { "type": "boolean" },
        "creatorUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "slug",
        "title",
        "subtitle",
        "category",
        "city",
        "venueName",
        "venueAddress",
        "dateLabel",
        "isoDate",
        "timeLabel",
        "timezone",
        "coverImage",
        "coverCaption",
        "description",
        "host",
        "schedule",
        "tiers",
        "refundPolicySummary",
        "creatorUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "TicketOrder": {
      "title": "TicketOrder",
      "description": "Confirmed or cancelled attendee ticket booking owned by a Firebase Auth user and manageable by Evora admins.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "intentId": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["confirmed", "refunded"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "refundedAt": { "type": "string", "format": "date-time" },
        "eventId": { "type": "string" },
        "eventSlug": { "type": "string" },
        "eventTitle": { "type": "string" },
        "eventDateLabel": { "type": "string" },
        "eventTimeLabel": { "type": "string" },
        "venueName": { "type": "string" },
        "venueAddress": { "type": "string" },
        "city": { "type": "string" },
        "tierId": { "type": "string" },
        "tierName": { "type": "string" },
        "quantity": { "type": "integer" },
        "buyerName": { "type": "string" },
        "buyerEmail": { "type": "string" },
        "buyerPhone": { "type": "string" },
        "paymentReference": { "type": "string" },
        "currency": { "type": "string", "enum": ["INR"] },
        "subtotalPaise": { "type": "integer" },
        "platformFeePaise": { "type": "integer" },
        "totalPaise": { "type": "integer" },
        "passes": { "type": "array" }
      },
      "required": [
        "orderId",
        "intentId",
        "userId",
        "status",
        "createdAt",
        "eventId",
        "eventSlug",
        "eventTitle",
        "eventDateLabel",
        "eventTimeLabel",
        "venueName",
        "venueAddress",
        "city",
        "tierId",
        "tierName",
        "quantity",
        "buyerName",
        "buyerEmail",
        "buyerPhone",
        "paymentReference",
        "currency",
        "subtotalPaise",
        "platformFeePaise",
        "totalPaise",
        "passes"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Allowlist marker document granting administrator control rights to a Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "grantedAt": { "type": "string", "format": "date-time", "maxLength": 40 }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Singleton platform configuration document (settings/platform) controlling live site copy, switches, commission, and fallback UPI.",
      "type": "object",
      "properties": {
        "heroHeadline": { "type": "string", "maxLength": 180 },
        "heroSubheadline": { "type": "string", "maxLength": 400 },
        "ctaHeadline": { "type": "string", "maxLength": 180 },
        "ctaSubheadline": { "type": "string", "maxLength": 400 },
        "announcementEnabled": { "type": "boolean" },
        "announcementText": { "type": "string", "maxLength": 240 },
        "announcementLinkLabel": { "type": "string", "maxLength": 60 },
        "announcementLinkUrl": { "type": "string", "maxLength": 240 },
        "showPricingPage": { "type": "boolean" },
        "showSeedEvents": { "type": "boolean" },
        "autoApproveEvents": { "type": "boolean" },
        "allowEventSubmissions": { "type": "boolean" },
        "allowBookings": { "type": "boolean" },
        "bookingsPausedMessage": { "type": "string", "maxLength": 260 },
        "platformFeePercent": { "type": "number", "minimum": 0, "maximum": 20 },
        "defaultPayoutVpa": { "type": "string", "maxLength": 100 },
        "defaultPayeeName": { "type": "string", "maxLength": 80 },
        "supportEmail": { "type": "string", "maxLength": 160 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 40 },
        "updatedBy": { "type": "string", "maxLength": 160 }
      },
      "required": [
        "heroHeadline",
        "heroSubheadline",
        "ctaHeadline",
        "ctaSubheadline",
        "announcementEnabled",
        "announcementText",
        "announcementLinkLabel",
        "announcementLinkUrl",
        "showPricingPage",
        "showSeedEvents",
        "autoApproveEvents",
        "allowEventSubmissions",
        "allowBookings",
        "bookingsPausedMessage",
        "platformFeePercent",
        "defaultPayoutVpa",
        "defaultPayeeName",
        "supportEmail",
        "updatedAt",
        "updatedBy"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User account profiles readable/writable by the owning user and manageable by Evora administrators."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Co-admin allowlist documents readable by the matching user and fully manageable by Evora administrators."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/EvoraEvent" },
      "description": "Event listings created by authenticated organizers and fully controlled by Evora administrators."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/TicketOrder" },
      "description": "Attendee ticket orders and issued passes readable by the owning attendee and manageable by Evora administrators."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSettings" },
      "description": "Publicly readable platform configuration singleton (settings/platform) writable exclusively by Evora administrators."
    }
  }
}
